{
	"$schema": "https://raw.githubusercontent.com/ErikReider/SwayNotificationCenter/main/data/swaync-config.schema.json",
	"positionX": "right",
	"positionY": "top",
	"layer": "overlay",
	"control-center-margin-top": 10,
	"control-center-margin-bottom": 10,
	"control-center-margin-right": 10,
	"control-center-margin-left": 10,
	"control-center-width": 460,
	"fit-to-screen": false,
	"control-center-height": 700,
	"notification-window-width": 400,
	"keyboard-shortcuts": true,
	"image-visibility": "when-available",
	"transition-time": 200,
	"hide-on-clear": false,
	"hide-on-action": true,
	"timeout": 10,
	"timeout-low": 5,
	"timeout-critical": 0,

	"widgets": [
		"dnd",
		"buttons-grid",
		"mpris",
		"volume",
		"title",
		"notifications"
	],

	"widget-config": {
		"dnd": {
			"text": "Do Not Disturb"
		},

		"buttons-grid": {
			"actions": [
				{
					"label": "⏻",
					"command": "pkill nwg-bar || nwg-bar"
				},
				{
					"label": "",
					"command": "$HOME/.config/hypr/scripts/LockScreen.sh"
				},
				{
					"label": "",
					"command": "$HOME/.config/hypr/scripts/AirplaneMode.sh"
				},
				{
					"label": "",
					"command": "$HOME/.config/hypr/scripts/Volume.sh --toggle"
				},
				{
					"label": "",
					"command": "blueman-manager"
				}
			]
		},

		"mpris": {
			"image-size": 80,
			"image-radius": 16
		},

		"volume": {
			"label": "󰕾",
			"show-per-app": true
		},

		"title": {
			"text": "Notifications",
			"clear-all-button": true,
			"button-text": "Clear"
		},

		"notifications": {
			"vexpand": true
		}
	}
}
