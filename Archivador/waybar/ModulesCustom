/* Waybar Modules - Custom Modules */
/* Basically created to reduce the lines in Waybar Modules bank */
/* NOTE: This is only for Custom Modules */
/* Custom Modules like weather browser, tty, file manager at the beginning */

{
// Apps en segundo plano (bgapps.sh)
// Leader del drawer: muestra el recuento de apps minimizadas.
// Clic izquierdo: manda la ventana activa a segundo plano.
// Clic derecho: restaura TODAS.
"custom/bgapps": {
	"format": "{text}",
	"return-type": "json",
	"interval": 2,
	"exec": "$HOME/.config/hypr/hyprland/scripts/bgapps.sh status",
	"exec-on-event": true,
	"on-click": "$HOME/.config/hypr/hyprland/scripts/bgapps.sh hide",
	"on-click-right": "$HOME/.config/hypr/hyprland/scripts/bgapps.sh restore-all",
	"on-click-middle": "$HOME/.config/hypr/hyprland/scripts/bgapps.sh hide-all",
	"tooltip": true,
},
// Slots del drawer: un módulo por posición. Muestran la app minimizada nº N
// y con un clic la restauran al workspace original.
"custom/bgapp1": {
	"format": "{text}",
	"return-type": "json",
	"interval": 2,
	"exec": "$HOME/.config/hypr/hyprland/scripts/bgapps.sh slot 1",
	"exec-on-event": true,
	"on-click": "$HOME/.config/hypr/hyprland/scripts/bgapps.sh restore 1",
	"tooltip": true,
},
