// ### [TOP] Minimal Espectro ### //
// Barra ultra minimal: transparente, solo iconos, active con subrayado.

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
"position": "top",
"margin-top": 6,

"modules-left": [
	"custom/menu",
	"clock",
	"temperature#cpu",
	"custom/gpu_temp",
	],

"modules-center": [
	"hyprland/workspaces#roman"
	],

"modules-right": [
	"custom/themes",
	"tray",
	"group/notify",
	"network", 
	"pulseaudio", 
	"battery", 
	"custom/power"],
}