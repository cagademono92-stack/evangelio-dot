// ### [TOP] Segmentado ### //
// Barra superior donde cada grupo (izq/centro/dcha) es una píldora separada.

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
"position": "top",
"width": 1100,
"margin-top": 6,

"modules-left": [
	"custom/menu",
	"clock",  
	"custom/weather", 
	"cpu",
	"memory",
	"temperature#cpu",
	"custom/gpu_temp",
	],

"modules-center": [
	"hyprland/workspaces#roman"
	],

"modules-right": [
	"custom/themes",
	"tray",
	"group/notify",
	"mpris", 
	"network", 
	"bluetooth", 
	"backlight", 
	"custom/display",
	"pulseaudio", 
	"battery", 
	"custom/power"],
}