(defwindow music
  :monitor 0
  :geometry (geometry :x "0" :y "14" :width "340" :height "112" :anchor "bottom center")
  :stacking "bg"
  :exclusive false
  :focusable false
  (music_widget))

(defwidget music_widget []
  (box :class "player" :orientation "vertical" :space-evenly false :halign "center" :valign "center"
    (box :orientation "horizontal" :space-evenly false :halign "center" :valign "center"
      (button :class "btn" :onclick "playerctl previous" "⏮")
      (button :class "btn play" :onclick "playerctl play-pause" "⏯")
      (button :class "btn" :onclick "playerctl next" "⏭")
      (box :class "info" :orientation "vertical" :space-evenly false :valign "center"
        (label :class "title" :text {title} :limit-width 26 :halign "start")
        (label :class "artist" :text {artist} :limit-width 26 :halign "start")))
    (label :class "cava" :text {cava} :halign "center")))

(defpoll title :interval "1s" "playerctl metadata title 2>/dev/null || echo 'Nada sonando'")
(defpoll artist :interval "1s" "playerctl metadata artist 2>/dev/null || echo ''")

; OJO: usamos defpoll y NO (defvar cava :type "file" ...) a propósito.
; El soporte de file monitors vía :type/:file/:poll-interval llegó en eww 0.6.0
; y esta máquina tiene eww 0.5.0, cuyo parser de defvar solo acepta
; (defvar nombre "valor"). Con :type "file" el reload falla y no levanta el yuck.
; Cuando actualices eww a >=0.6, esto se puede pasar a:
;   (defvar cava :type "file" :file "/tmp/eww-cava.txt"
;     :poll-interval 66 :monitor 0)
; y así evitar el proceso por poll.
;
; El `|| true` evita que el poll salga con error (y ensucie el log con un warning
; cada 80ms) mientras el bridge todavía no haya escrito el archivo.
(defpoll cava :interval "80ms" "cat /tmp/eww-cava.txt 2>/dev/null || true")

(defwindow clock
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "700" :height "260" :anchor "center")
  :stacking "background"
  :exclude-for true
  :focusable false
  (big_clock))

(defwidget big_clock []
  (box :orientation "vertical" :space-evenly false :halign "center" :valign "center"
    (label :class "big-time" :text {bigtime})
    (label :class "big-date" :text {bigdate})))

(defpoll bigtime :interval "1s" "date '+%H:%M'")
(defpoll bigdate :interval "60s" "date '+%A, %d %B'")

(defwindow weather
  :monitor 0
  :geometry (geometry :x "16" :y "14" :width "220" :height "64" :anchor "bottom left")
  :stacking "background"
  :exclusive false
  :focusable false
  (weather_widget))

(defwidget weather_widget []
  (box :class "weather" :halign "center" :valign "center"
    (label :class "weather-text" :text {weather} :halign "center")))

(defpoll weather :interval "900s" "bash $HOME/.config/eww/weather.sh")

