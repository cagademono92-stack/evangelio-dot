/* ---- 🟩 https://github.com/JaKooLit 🟩 ---- */
/* Tema "minecraft" — launcher estilo puzzle/inventario de Minecraft:
   panel de caverna oscura con moldura de hierba, elementos como bloques
   de piedra con bisel y selección verde hierba con marco de oro.
   Combina con la barra [Top] Minecraft. */

/* ---- Paleta Minecraft (fija, no wallust) ---- */
* {
    mc-cave:            #171616;
    mc-cave-panel:      #222120;
    mc-stone:           #464442;
    mc-stone-dark:      #3a3836;
    mc-outline:         #0c0c0c;
    mc-slab:            #2a2927;
    mc-dirt:            #8a5a33;
    mc-grass:           #7cbd6b;
    mc-deep-grass:      #3d6b35;
    mc-gold:            #f5d442;
    mc-bone:            #f4efe2;
    mc-redstone:        #e14d4d;

    selected:           @mc-grass;
    active:             @mc-gold;
    text-selected:      #0d1f0b;
    urgent:             @mc-redstone;
    border-color:       @mc-grass;
}

/* ---- Configuración ---- */
configuration {
    modi:                       "drun,run,filebrowser,window,wallpaper";
    show-icons:                 true;
    display-drun:               "⛏ ";
    display-run:                "➤ ";
    display-filebrowser:        "🗄 ";
    display-window:             "▣ ";
    drun-display-format:        "{name}";
    display-wallpaper:          "Wallpaper ";
    hover-select:               true;
    case-sensitive:             false;
}

/* ---- Window: panel de inventario ---- */
window {
    width:                      680px;
    x-offset:                   0px;
    y-offset:                   0px;
    spacing:                    0px;
    padding:                    0px;
    margin:                     5px;
    border:                     2px;
    border-color:               @mc-outline;
    cursor:                     "default";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    enabled:                    true;
    border-radius:              4px;
    background-color:           @mc-cave;
}

/* ---- Mainbox: marco de tierra/hierba ---- */
mainbox {
    enabled:                    true;
    orientation:                vertical;
    padding:                    14px;
    children:                   [ "inputbar", "listbox" ];
    border-radius:              3px;
    background-color:           @mc-cave;
}

/* ---- Listbox ---- */
listbox {
    spacing:                    8px;
    orientation:                vertical;
    children:                   [ "message", "listview" ];
    padding:                    8px;
    border-radius:              3px;
    background-color:           transparent;
    border:                     0px;
}

/* ---- Inputbar: bloque de piedra ---- */
inputbar {
    enabled:                    true;
    text-color:                 @mc-bone;
    spacing:                    10px;
    border-radius:              3px;
    border:                     2px;
    border-color:               @mc-outline;
    background-color:           @mc-slab;
    children:                   [ "mode-switcher", "textbox-prompt-colon", "entry" ];
    padding:                    0px 10px 0px 10px;
    margin-bottom:              12px;
}

textbox-prompt-colon {
    enabled:                    true;
    padding:                    10px 2px 10px 4px;
    expand:                     false;
    str:                        "▣ ";
    text-color:                 @mc-grass;
    background-color:           transparent;
}

entry {
    enabled:                    true;
    padding:                    10px 0px 10px 0px;
    text-color:                 @mc-bone;
    cursor:                     text;
    placeholder:                "  Buscar…";
    background-color:           transparent;
}

mode-switcher {
    enabled:                    true;
    spacing:                    6px;
    background-color:           transparent;
    text-color:                 @mc-bone;
}

button {
    padding:                    8px 12px 8px 12px;
    border-radius:              3px;
    background-color:           @mc-slab;
    text-color:                 @mc-bone;
    cursor:                     pointer;
    border:                     2px;
    border-color:               @mc-outline;
}

button selected {
    background-color:           @mc-grass;
    text-color:                 @text-selected;
    border-color:               @mc-gold;
}

/* ---- Listview: rejilla tipo inventario ---- */
listview {
    enabled:                    true;
    columns:                    4;
    lines:                      3;
    spacing:                    6px;
    padding:                    0px;
    dynamic:                    true;
    cycle:                      true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              false;
    background-color:           transparent;
    border-radius:              0px;
    border:                     0px;
}

scrollbar {
    border:                     0px;
    border-radius:              0px;
    background-color:           transparent;
    handle-color:               @mc-gold;
    handle-width:               3px;
    padding:                    0;
}

/* ---- Element: bloque del inventario ---- */
element {
    enabled:                    true;
    padding:                    16px 14px 16px 14px;
    margin:                     3px;
    cursor:                     pointer;
    background-color:           @mc-slab;
    border-radius:              3px;
    border:                     2px;
    border-color:               @mc-outline;
}

element normal.normal {
    background-color:           inherit;
    text-color:                 inherit;
}

element normal.urgent {
    background-color:           inherit;
    text-color:                 inherit;
}

element normal.active {
    background-color:           inherit;
    text-color:                 inherit;
}

element-text selected,
element selected.normal {
    background-color:           @mc-grass;
    text-color:                 @text-selected;
    border-color:               @mc-gold;
}

element selected.urgent {
    background-color:           inherit;
    text-color:                 inherit;
}

element selected.active {
    background-color:           inherit;
    text-color:                 inherit;
}

element-icon {
    background-color:           transparent;
    text-color:                 @mc-grass;
    size:                       36px;
    cursor:                     inherit;
}

element selected.normal element-icon {
    text-color:                 @text-selected;
}

element-text {
    background-color:           transparent;
    text-color:                 @mc-bone;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

message {
    background-color:           transparent;
    border:                     0px;
}

textbox {
    padding:                     10px;
    border-radius:              3px;
    background-color:            @mc-slab;
    text-color:                  @mc-bone;
    border:                      2px;
    border-color:                @mc-outline;
}

error-message {
    padding:                     12px;
    border-radius:               3px;
    background-color:            @mc-cave-panel;
    text-color:                  @mc-redstone;
}