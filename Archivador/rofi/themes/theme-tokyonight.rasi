/* ---- 💝 https://github.com/JaKooLit 💝 ---- */
/* Tema "tokyonight" — basado en la config principal de rofi (KooL_style-5) */

@theme "~/.config/rofi/theme/KooL_style-5.rasi"

/* ---- Paleta "tokyonight" ---- */
* {
	background:            #1a1b26;
	background-color:      #1a1b26;
	background-alt:        #24283b;
	foreground:            #c0caf5;
	selected:              #7aa2f7;
	active:                #bb9af7;
	text-selected:         #1a1b26;
	urgent:                #f7768e;

	color0:  #1a1b26;
	color1:  #24283b;
	color2:  #7aa2f7;
	color3:  #bb9af7;
	color4:  #7aa2f7;
	color5:  #f7768e;
	color6:  #24283b;
	color7:  #c0caf5;
	color8:  #24283b;
	color9:  #f7768e;
	color10: #7aa2f7;
	color11: #bb9af7;
	color12: #7aa2f7;
	color13: #7aa2f7;
	color14: #bb9af7;
	color15: #c0caf5;
}