/* ---- 🎰 https://github.com/JaKooLit 🎰 ---- */
/* Tema "segmentos" — launcher centrado con bloques separados (búsqueda y
   lista en píldoras), combina con la barra [Top] Segmentos. */

/* ---- Configuration ---- */
configuration {
    modi:                       "drun,run,filebrowser,wallpaper";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        " ";
    display-window:             " ";
    drun-display-format:        "{name}";
    display-wallpaper:          "Wallpaper ";
    hover-select:               true;
}

/* ---- Load wallust colors (dinámicos según wallpaper) ---- */
@theme "~/.config/rofi/wallust/colors-rofi.rasi"

/* ---- Mapeo semántico al wallpaper (el resto lo define colors-rofi.rasi) ---- */
* {
    selected:                   @color10;
    active:                     @color3;
    text-selected:              @background;
    urgent:                     @color9;
    border-color:               @color10;
}

/* ---- Window ---- */
window {
    width:                      640px;
    x-offset:                   0px;
    y-offset:                   0px;
    spacing:                    10px;
    padding:                    0px;
    margin:                     0px;
    border:                     2px;
    border-color:               @border-color;
    cursor:                     "default";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    enabled:                    true;
    border-radius:              24px;
    background-color:           @background-color;
}

/* ---- Mainbox: segmentos separados ---- */
mainbox {
    enabled:                    true;
    orientation:                vertical;
    padding:                    14px;
    children:                   [ "inputbar", "listbox" ];
    border-radius:              22px;
}

/* ---- Listbox: píldora inferior ---- */
listbox {
    spacing:                    4px;
    orientation:                vertical;
    children:                   [ "message", "listview" ];
    padding:                    8px;
    border-radius:              18px;
    background-color:           @background;
}

/* ---- Inputbar: píldora superior resaltada ---- */
inputbar {
    enabled:                    true;
    text-color:                 @foreground;
    spacing:                    10px;
    border-radius:              18px;
    border:                     2px;
    border-color:               @border-color;
    background-color:           @background;
    children:                   [ "mode-switcher", "textbox-prompt-colon", "entry" ];
    padding:                    0px 10px 0px 10px;
    margin-bottom:              12px;
}

textbox-prompt-colon {
    enabled:                    true;
    padding:                    10px 0px 10px 10px;
    expand:                     false;
    str:                        "󰚩 ";
    text-color:                 @selected;
    background-color:           transparent;
}

entry {
    enabled:                    true;
    padding:                    10px 0px 10px 0px;
    text-color:                 @foreground;
    cursor:                     text;
    placeholder:                "  Buscar…";
    background-color:           @background;
}

mode-switcher {
    enabled:                    true;
    spacing:                    10px;
    background-color:           transparent;
    text-color:                 @foreground;
}

button {
    padding:                    8px 16px 8px 16px;
    border-radius:             14px;
    background-color:          @background-alt;
    text-color:                @foreground;
    cursor:                    pointer;
    border:                    0px;
}

button selected {
    background-color:          @selected;
    text-color:                @text-selected;
    border:                    0px;
}

/* ---- Listview ---- */
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    spacing:                    4px;
    padding:                    4px;
    dynamic:                    true;
    cycle:                      true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              false;
    background-color:           transparent;
    border-radius:              16px;
    border:                     0px;
}

scrollbar {
    border:                     0px;
    border-radius:              8px;
    background-color:           transparent;
    handle-color:               @active;
    handle-width:               2px;
    padding:                    0;
}

/* ---- Element ---- */
element {
    enabled:                    true;
    padding:                    12px;
    margin:                     2px 0px;
    cursor:                     pointer;
    background-color:           transparent;
    border-radius:              14px;
    border:                     0px;
}

element normal.normal {
    background-color:           inherit;
    text-color:                 inherit;
}

element normal.urgent {
    background-color:           inherit;
    text-color:                 inherit;
}

element normal.active {
    background-color:           inherit;
    text-color:                 inherit;
}

element-text selected,
element selected.normal {
    background-color:           @selected;
    text-color:                 @text-selected;
}

element selected.urgent {
    background-color:           inherit;
    text-color:                 inherit;
}

element selected.active {
    background-color:           inherit;
    text-color:                 inherit;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0;
}

message {
    background-color:           transparent;
    border:                     0px;
}

textbox {
    padding:                     10px;
    border-radius:              12px;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

error-message {
    padding:                     12px;
    border-radius:               12px;
    background-color:            @background-alt;
    text-color:                  @foreground;
}