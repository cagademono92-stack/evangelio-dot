/* ---- 💝 https://github.com/JaKooLit 💝 ---- */
/* Tema "dracula" — basado en la config principal de rofi (KooL_style-5) */

@theme "~/.config/rofi/theme/KooL_style-5.rasi"

/* ---- Paleta "dracula" ---- */
* {
	background:            #282a36;
	background-color:      #282a36;
	background-alt:        #3b3f54;
	foreground:            #f8f8f2;
	selected:              #bd93f9;
	active:                #ff79c6;
	text-selected:         #282a36;
	urgent:                #ff5555;

	color0:  #282a36;
	color1:  #3b3f54;
	color2:  #bd93f9;
	color3:  #ff79c6;
	color4:  #bd93f9;
	color5:  #ff5555;
	color6:  #3b3f54;
	color7:  #f8f8f2;
	color8:  #44475a;
	color9:  #ff5555;
	color10: #bd93f9;
	color11: #ff79c6;
	color12: #bd93f9;
	color13: #bd93f9;
	color14: #ff79c6;
	color15: #f8f8f2;
}