/* ---- 💝 https://github.com/JaKooLit 💝 ---- */
/* Tema "everforest" — basado en la config principal de rofi (KooL_style-5) */

@theme "~/.config/rofi/theme/KooL_style-5.rasi"

/* ---- Paleta "everforest" ---- */
* {
	background:            #2f383e;
	background-color:      #2f383e;
	background-alt:        #3a444c;
	foreground:            #d3c6aa;
	selected:              #83c092;
	active:                #e69875;
	text-selected:         #2f383e;
	urgent:                #e67e80;

	color0:  #2f383e;
	color1:  #3a444c;
	color2:  #83c092;
	color3:  #e69875;
	color4:  #83c092;
	color5:  #e67e80;
	color6:  #3a444c;
	color7:  #d3c6aa;
	color8:  #3a444c;
	color9:  #e67e80;
	color10: #83c092;
	color11: #e69875;
	color12: #83c092;
	color13: #83c092;
	color14: #e69875;
	color15: #d3c6aa;
}