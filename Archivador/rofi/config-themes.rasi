/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* Config del selector de temas (waybar + rofi) */

@import "~/.config/rofi/config.rasi"

/* ---- Mainbox ---- */
mainbox {
  children: [ "inputbar", "message", "listview"];
}

/* ---- Configuration ---- */
configuration {
  modi: "drun";
  markup-rows: true;
}

/* ---- Window ---- */
window {
  width: inherit;
  height: inherit;
}

/* ---- Entry ---- */
entry {
  expand: true;
  placeholder: " 🎨 Elige un tema (waybar + rofi)";
}

/* ---- Listview ---- */
listview {
  columns: 1;
  lines: 12;
  fixed-height: false;
  margin: 10px;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element-icon {
  size: 0%;
}
element-text {
  horizontal-align: 0.0;
  margin: 0px;
  padding: 0px 10px;
}